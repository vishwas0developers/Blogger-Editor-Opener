{
    "manifest_version": 3,
    "name": "Blogger Post Editor",
    "version": "1.3",
    "description": "Open the Blogger post editor for the current post, even on custom domains.",
    "permissions": ["activeTab", "scripting", "notifications"],
    "host_permissions": ["<all_urls>"], 
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Blogger Post Editor",
      "default_icon": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
      }
    },
    "icons": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
  